# CFMOTO CFORCE 520L recovered hardware profile.
# Bench-test only: actuator power disconnected while loading and validating.

# Keep DBW disabled until gas, brake, steering and gearbox are verified.
MAUL_ENABLE,0

# Active-low gearbox input patterns recovered from the legacy binary.
# D3..D7 idle HIGH; exactly one selected input is pulled LOW.
MAUL_DIO_MASK,248
MAUL_DIO_P,240
MAUL_DIO_R,232
MAUL_DIO_N,216
MAUL_DIO_H,184
MAUL_DIO_L,120

# Expanded shift state machine. RPM interlock stays disabled until the
# identities and scaling of RPM1/RPM2 are confirmed on the vehicle.
MAUL_SH_BRK_MS,750
MAUL_SH_STOP_MS,500
MAUL_SH_NEUT_MS,500
MAUL_SH_TMO,5000
MAUL_SH_RPM_I,0
MAUL_SH_RPM_MAX,1000

# Boxer operator controls: SA/CH3 requests Arm/Disarm and ignition, while
# momentary SF/CH1 requests one guarded starter attempt. RPM2 is the engine
# tachometer input; automatic retries are disabled.
MAUL_ENG_EN,1
MAUL_IGN_CH,3
MAUL_START_CH,1
MAUL_ENG_RPM_I,2
MAUL_ENG_RUN_RPM,600
MAUL_ENG_DLY,500
MAUL_ENG_CRANK,3000
MAUL_ENG_RETRY_D,2000
MAUL_ENG_RETRIES,0

# Boxer switches: SC drives 2x2/4x4/differential lock through CH7/CH10,
# with 4WD on AUX3 and differential lock on AUX4.
MAUL_4WD_CH,7
MAUL_DIFF_CH,10
MAUL_LIGHT_CH,0
MAUL_EW_CH,0
MAUL_AXLE_SPD,0.2
MAUL_AXLE_RPM_I,0
MAUL_AXLE_RPM,500

# Legacy five-position gearbox calibration; presumed P/R/N/H/L order.
MAUL_GEAR_P,1000
MAUL_GEAR_R,1225
MAUL_GEAR_N,1500
MAUL_GEAR_H,1725
MAUL_GEAR_L,2000
MAUL_GEAR_CH,6
MAUL_GIN_P,1755
MAUL_GIN_R,1535
MAUL_GIN_N,1412
MAUL_GIN_H,1295
MAUL_GIN_L,1075
MAUL_GIN_TOL,50

# Separate proportional controls from the Boxer model. Brake overrides gas.
# SD/CH8 limits maximum gas demand to 50 percent when active.
MAUL_GAS_CH,2
MAUL_BRK_CH,5
MAUL_THR_LIM_CH,8
MAUL_THR_LIM,50

# Verified legacy actuator output envelope.  Steering remains 1000..2000.
SERVO1_MIN,988
SERVO1_TRIM,1500
SERVO1_MAX,2012
SERVO2_MIN,988
SERVO2_TRIM,1500
SERVO2_MAX,2012
SERVO3_MIN,1000
SERVO3_TRIM,1500
SERVO3_MAX,2000
SERVO4_MIN,988
SERVO4_TRIM,1500
SERVO4_MAX,2012
SERVO_RATE,50
RCMAP_ROLL,4
RCMAP_THROTTLE,2

# Four vehicle relays, all default OFF.
# 1 ignition/MAIN5; 2 starter/MAIN6; 3 four-wheel drive/AUX3;
# 4 differential lock/AUX4. Relays 5 and 6 are disabled.
# Their shared servo functions must stay disabled so the GPIOs are not driven
# simultaneously by SRV_Channel and AP_Relay.
SERVO5_FUNCTION,-1
SERVO6_FUNCTION,-1
SERVO9_FUNCTION,0
SERVO10_FUNCTION,0
SERVO11_FUNCTION,-1
SERVO12_FUNCTION,-1
RELAY1_FUNCTION,1
RELAY1_PIN,105
RELAY1_DEFAULT,0
RELAY2_FUNCTION,1
RELAY2_PIN,106
RELAY2_DEFAULT,0
RELAY3_FUNCTION,1
RELAY3_PIN,52
RELAY3_DEFAULT,0
RELAY4_FUNCTION,1
RELAY4_PIN,53
RELAY4_DEFAULT,0
RELAY5_FUNCTION,0
RELAY5_PIN,-1
RELAY5_DEFAULT,0
RELAY6_FUNCTION,0
RELAY6_PIN,-1
RELAY6_DEFAULT,0

# Recovered frequency inputs. AUX5/AUX6 must remain GPIO, not PWM outputs.
SERVO13_FUNCTION,-1
SERVO14_FUNCTION,-1
RPM1_TYPE,2
RPM1_PIN,54
RPM1_SCALING,0.00058
RPM1_MIN,0.5
RPM1_MAX,100000
RPM1_MIN_QUAL,0
RPM2_TYPE,2
RPM2_PIN,55
RPM2_SCALING,1
RPM2_MIN,10
RPM2_MAX,100000
RPM2_MIN_QUAL,0

# ELRS/CRSF receiver on TELEM2 (SERIAL2). Baud is managed automatically.
SERIAL1_PROTOCOL,-1
SERIAL2_PROTOCOL,23
SERIAL2_OPTIONS,0
RSSI_TYPE,3
# Use ELRS 420 kbaud and require idle throttle before arming.
RC_OPTIONS,8224

RC3_OPTION,153
