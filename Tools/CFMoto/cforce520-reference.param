# CFMOTO CFORCE 520L recovered hardware profile.
# Bench-test only: actuator power disconnected while loading and validating.

# Keep DBW disabled until gas, brake, steering and gearbox are verified.
ATV_ENABLE,0

# Active-low gearbox input patterns recovered from the legacy binary.
# D3..D7 idle HIGH; exactly one selected input is pulled LOW.
ATV_DIO_MASK,248
ATV_DIO_P,240
ATV_DIO_R,232
ATV_DIO_N,216
ATV_DIO_H,184
ATV_DIO_L,120

# Expanded shift state machine. RPM interlock stays disabled until the
# identities and scaling of RPM1/RPM2 are confirmed on the vehicle.
ATV_SH_BRK_MS,750
ATV_SH_STOP_MS,500
ATV_SH_NEUT_MS,500
ATV_SH_TMO,5000
ATV_SH_RPM_I,0
ATV_SH_RPM_MAX,1000

# Starter state machine is deliberately disabled until relay polarity and
# the engine RPM input are proven. Legacy operator channels are retained.
ATV_ENG_EN,0
ATV_IGN_CH,12
ATV_START_CH,9
ATV_ENG_RPM_I,0
ATV_ENG_RUN_RPM,600
ATV_ENG_DLY,500
ATV_ENG_CRANK,3000
ATV_ENG_RETRY_D,2000
ATV_ENG_RETRIES,2

# Old RC1/RC3 mappings conflict with current steering/throttle, so 4WD and
# differential-lock channels remain unassigned until the transmitter map is final.
ATV_4WD_CH,0
ATV_DIFF_CH,0
ATV_AXLE_SPD,0.2
ATV_AXLE_RPM_I,0
ATV_AXLE_RPM,500

# Legacy five-position gearbox calibration; presumed P/R/N/H/L order.
ATV_GEAR_P,1000
ATV_GEAR_R,1225
ATV_GEAR_N,1500
ATV_GEAR_H,1725
ATV_GEAR_L,2000

# Verified legacy actuator output envelope.  Steering remains 1000..2000.
SERVO1_MIN,988
SERVO1_TRIM,1500
SERVO1_MAX,2012
SERVO2_MIN,988
SERVO2_TRIM,1500
SERVO2_MAX,2012
SERVO3_MIN,1000
SERVO3_TRIM,1500
SERVO3_MAX,2000
SERVO4_MIN,988
SERVO4_TRIM,1500
SERVO4_MAX,2012
SERVO_RATE,50

# Six vehicle relays, all default OFF.
# 1 ignition; 2 starter; 3 headlights; 4 EW payload;
# 5 differential lock; 6 four-wheel drive.
RELAY1_FUNCTION,1
RELAY1_PIN,50
RELAY1_DEFAULT,0
RELAY2_FUNCTION,1
RELAY2_PIN,51
RELAY2_DEFAULT,0
RELAY3_FUNCTION,1
RELAY3_PIN,52
RELAY3_DEFAULT,0
RELAY4_FUNCTION,1
RELAY4_PIN,53
RELAY4_DEFAULT,0
RELAY5_FUNCTION,1
RELAY5_PIN,105
RELAY5_DEFAULT,0
RELAY6_FUNCTION,1
RELAY6_PIN,106
RELAY6_DEFAULT,0

# Recovered frequency inputs. AUX5/AUX6 must remain GPIO, not PWM outputs.
SERVO13_FUNCTION,-1
SERVO14_FUNCTION,-1
RPM1_TYPE,2
RPM1_PIN,54
RPM1_SCALING,0.00058
RPM1_MIN,0.5
RPM1_MAX,100000
RPM1_MIN_QUAL,0
RPM2_TYPE,2
RPM2_PIN,55
RPM2_SCALING,1
RPM2_MIN,10
RPM2_MAX,100000
RPM2_MIN_QUAL,0

# ELRS/CRSF receiver on TELEM1 (SERIAL1). Baud is managed automatically.
SERIAL1_PROTOCOL,23
SERIAL1_OPTIONS,0
RSSI_TYPE,3
# Use ELRS 420 kbaud and require idle throttle before arming.
RC_OPTIONS,8224
